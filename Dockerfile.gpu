FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /app
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv git build-essential && rm -rf /var/lib/apt/lists/*
COPY requirements-gpu.txt .
RUN python3 -m pip install --no-cache-dir -r requirements-gpu.txt
COPY . .
RUN python3 -m pip install -e .
CMD ["bash", "-lc", "pytest -v && python3 benchmarks/run_end_to_end.py && python3 benchmarks/benchmark_cpu_gpu.py"]
